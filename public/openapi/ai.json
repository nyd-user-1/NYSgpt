{
  "openapi": "3.0.3",
  "info": {
    "title": "NYSgpt AI API",
    "version": "1.0.0",
    "description": "Records of AI research, patents, models and policy in 81 tables and 61.8 million rows: 1.32 million AI patents from the USPTO's AI Patent Dataset plus 87,047 newer grants awaiting classification, with 11.2 million patent citations, their assignments, assignees and maintenance events; 3.57 million research papers with 21.2 million citation links, their funders and institutions; Hugging Face models and repositories and the papers they cite; benchmark and leaderboard scores; Epoch AI's records of models, chips and data centers; and AI incidents and governance documents. Every response is JSON in the form {data, meta}."
  },
  "servers": [
    {
      "url": "https://api.nysgpt.com/v1"
    }
  ],
  "security": [
    {
      "apiKey": []
    }
  ],
  "paths": {
    "/ai": {
      "get": {
        "operationId": "listTables",
        "summary": "List the dataset's tables",
        "description": "Every table with its row count, columns and the columns it can be filtered and ordered on. Read this before queryTable.",
        "responses": {
          "200": {
            "description": "The tables.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Table"
                      }
                    },
                    "meta": {
                      "$ref": "#/components/schemas/Meta"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/TooMany"
          },
          "503": {
            "$ref": "#/components/responses/Busy"
          },
          "504": {
            "$ref": "#/components/responses/TooSlow"
          }
        }
      }
    },
    "/ai/{table}": {
      "get": {
        "operationId": "queryTable",
        "summary": "Query any table",
        "description": "Rows from one table, filtered on its filter columns (see listTables): col=value for equality, col.gte, col.lte, col.gt, col.lt for ranges. A date takes YYYY-MM-DD, a time YYYY-MM-DD HH:MM:SS in UTC, and a list column matches whole, as col={a,b}. order=col ascending or order=-col descending. limit 1 to 100 (default 25) and offset for paging.",
        "parameters": [
          {
            "name": "table",
            "in": "path",
            "required": true,
            "description": "The table's path, from listTables.",
            "schema": {
              "type": "string",
              "enum": [
                "agora-records",
                "agora-segments",
                "analysis-creators",
                "analysis-media",
                "analysis-models",
                "cve-monthly-counts",
                "doc-funder-links",
                "doc-org-links",
                "document-chunks",
                "document-citations",
                "document-clusters",
                "documents",
                "epoch-benchmark-runs",
                "epoch-chip-components",
                "epoch-chip-owners",
                "epoch-chip-sales-orgs",
                "epoch-chip-sales-timelines",
                "epoch-chip-sales-types",
                "epoch-companies",
                "epoch-data-centers",
                "epoch-dc-chillers",
                "epoch-dc-chip-quantities",
                "epoch-dc-cooling-towers",
                "epoch-dc-timelines",
                "epoch-gpu-clusters",
                "epoch-ml-hardware",
                "epoch-models",
                "epoch-models-frontier",
                "epoch-models-large-scale",
                "epoch-models-notable",
                "eto-country-metrics",
                "eto-openalex-overlay",
                "eto-patent-clusters",
                "eto-research-clusters",
                "ext-benchmark-scores",
                "ext-benchmarks",
                "framework-versions",
                "funding-awards",
                "harm-taxonomy-category",
                "harm-taxonomy-source",
                "hf-adoption-history",
                "hf-model-papers",
                "hf-models",
                "hf-paper-adoption",
                "hf-repos",
                "incidents",
                "irs-filers",
                "irs-grants",
                "lab-org-map",
                "llmstats-benchmarks",
                "llmstats-model-providers",
                "llmstats-models",
                "llmstats-providers",
                "llmstats-rankings",
                "llmstats-scores",
                "lmarena-entries",
                "openreview-links",
                "openreview-notes",
                "organization-identifiers",
                "organizations",
                "paper-metadata",
                "passages",
                "s2-papers",
                "source-editions",
                "sources",
                "uspto-applications",
                "uspto-assignees",
                "uspto-assignments",
                "uspto-cpc-titles",
                "uspto-foreign-priority",
                "uspto-gov-contracts",
                "uspto-gov-interest",
                "uspto-gov-interest-org",
                "uspto-locations",
                "uspto-maintenance-codes",
                "uspto-maintenance-events",
                "uspto-patent-citations",
                "uspto-patent-meta",
                "uspto-patents",
                "uspto-term-of-grant",
                "uspto-wipo-fields"
              ]
            }
          },
          {
            "name": "filters",
            "in": "query",
            "required": false,
            "style": "form",
            "explode": true,
            "description": "Filters as column=value pairs, e.g. doc_type=paper or published_date.gte=2025-01-01.",
            "schema": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          },
          {
            "name": "order",
            "in": "query",
            "required": false,
            "description": "A filter column to sort on; prefix with - for descending.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Rows to return, 1 to 100. Default 25.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "description": "Rows to skip, for paging.",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The rows.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": true
                      }
                    },
                    "meta": {
                      "$ref": "#/components/schemas/Meta"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/TooMany"
          },
          "503": {
            "$ref": "#/components/responses/Busy"
          },
          "504": {
            "$ref": "#/components/responses/TooSlow"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "apiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key"
      }
    },
    "responses": {
      "BadRequest": {
        "description": "A missing or invalid parameter, or a response over 5 MB (ask for fewer rows).",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "error": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "Forbidden": {
        "description": "A missing or invalid key, or a key whose plan does not include this table.",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "error": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "NotFound": {
        "description": "No such table or record.",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "error": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "TooMany": {
        "description": "The plan's monthly calls or rate limit is reached.",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "error": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "Busy": {
        "description": "The API is busy; try again in a few seconds.",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "error": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "TooSlow": {
        "description": "The query ran past 24 seconds and was stopped; narrow it with a filter.",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "error": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "schemas": {
      "Meta": {
        "type": "object",
        "properties": {
          "dataset": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "count": {
            "type": "integer"
          },
          "ms": {
            "type": "integer"
          }
        }
      },
      "Table": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "rows": {
            "type": "integer"
          },
          "columns": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "filters": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}